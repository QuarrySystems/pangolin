# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo

# Test / coverage output
coverage/

# Environment
.env

# Deploy artifacts fetched at runtime (the laptop pulls this from the serve stack's bucket)
deploy/serve-stack/client/public-key.json

# Logs
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent / tooling config (personal, not part of the product) — except the
# audit charter, which is deliberately shared. The parallel-lens audit reads it
# to learn what this repo actually enforces (e.g. that `typecheck:test` is
# opt-in per package), so it has to exist for teammates and CI runs, not just
# on one machine.
#
# `.claude/*` rather than `.claude/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the negation below only takes effect against a glob.
.claude/*
!.claude/audit-charter.md

# Per-lens audit reports. Working artifacts — the durable summary is the
# `## Audit record` section written into each spec/plan. Large and regenerable.
.audit/

# RFC 3161 spike: dependencies + lockfile are throwaway (ratified versions live in FINDINGS.md)
spike/rfc3161/node_modules/
spike/rfc3161/package-lock.json

# dogfood-gated fake-mode ($0) run artifacts — throwaway; the committed real-run
# proof (bundle.json / verify-context.json / patches/) must never be clobbered.
examples/dogfood-gated/fake-out/

# Sealed bundles from ad-hoc serve-stack client runs. These land next to the
# committed smoke fixture (smoke.mjs / smoke-plan.json), so without this they
# read as files someone meant to keep. They are run OUTPUT — regenerate them.
# A committed sealed bundle is also a standing hash-chain liability: the #59
# repo-wide agora://->pangolin:// substitution rewrote one in place and broke
# its verify, which is why examples/**/bundle.json is pinned -text in
# .gitattributes. Don't grow that surface here.
deploy/serve-stack/client/*-bundle.json
deploy/serve-stack/client/loop-proof.json
