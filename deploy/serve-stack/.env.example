# deploy/serve-stack/.env — copy to `.env` in this directory and fill in.
# docker-compose reads this file directly (env_file: .env on serve, plus
# ${...} interpolation against the project-local .env) — no export step.
#
# NOTE: this is the SERVE-STACK .env, not the repo-root one. A credential set
# only at the repo root does not reach the serve container.

# ---------------------------------------------------------------------------
# Claude credential — serve-side ONLY. Staged per-dispatch through the
# LocalStack Secrets Manager lane; the laptop never holds it.
#
# Two mutually-exclusive lanes. Fill in EXACTLY ONE:
#
#   subscription — a Claude Pro/Max OAuth token (mint with `claude setup-token`).
#                  Bills the subscription and draws on its usage allowance; no
#                  API credits. These tokens expire — when dispatches start
#                  failing on credentials, re-mint and restart serve.
#   api-key      — an Anthropic API key. Bills the API organization per-token.
#
# claudeAuthSecrets() (packages/pangolin-core/src/claude-auth.ts) stages exactly
# one env var and never both: the claude CLI ranks ANTHROPIC_API_KEY ABOVE
# CLAUDE_CODE_OAUTH_TOKEN, so staging both would silently bill the API org and
# defeat the subscription.
# ---------------------------------------------------------------------------

# Lane 1 — subscription (Claude Pro/Max)
CLAUDE_CODE_OAUTH_TOKEN=

# Lane 2 — API key
ANTHROPIC_API_KEY=

# Pin the lane explicitly: `subscription` | `api-key`. Leave empty to auto-select
# (a non-empty OAuth token picks subscription, otherwise api-key). Pinning is
# worth it on an always-on stack: if the credential for the pinned lane is blank
# or expired, the run fails on THAT lane instead of silently falling through to
# the other one with an empty value.
PANGOLIN_CLAUDE_AUTH=

# GID of the host's /var/run/docker.sock, so the non-root serve user (uid 1000)
# can launch sibling workers. Find it with:
# $(docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c '%g' /var/run/docker.sock)
# Leave empty to use the compose default (999 — matches most Linux hosts).
DOCKER_GID=
